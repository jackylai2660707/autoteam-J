# 邮箱提供者：swap_seat pending invite 注册主路径使用 Cloudflare Temp Email
MAIL_PROVIDER=cloudflare_temp_email

# CloudMail
CLOUDMAIL_BASE_URL=https://example.com/api
CLOUDMAIL_EMAIL=admin@example.com
CLOUDMAIL_PASSWORD=your_password
CLOUDMAIL_DOMAIN=@example.com

# Cloudflare Temp Email
CF_TEMP_EMAIL_BASE_URL=https://tempmail.example.com
CF_TEMP_EMAIL_ADMIN_PASSWORD=your_admin_password
# 支持单域名、多域名、随机子域名模板；例如：
# example.com
# xxxxx.a.com;xxxxx.b.com
# {random}.a.com;{random}.b.com
# *.a.com;*.b.com
CF_TEMP_EMAIL_DOMAIN=example.com

# 远端同步目标开关（建议显式设置，避免占位值被误判为已启用）
SYNC_TARGET_CPA=false
SYNC_TARGET_SUB2API=false

# CPA (CLIProxyAPI)
CPA_URL=http://127.0.0.1:8317
CPA_KEY=your_key

# Sub2API
SUB2API_URL=http://127.0.0.1:8080
SUB2API_EMAIL=admin@example.com
SUB2API_PASSWORD=your_password
SUB2API_GROUP=
# Sub2API 已存在代理的 ID 或名称（可选，仅账号池新建账号时写入 proxy_id）
SUB2API_PROXY=
SUB2API_CONCURRENCY=10
SUB2API_PRIORITY=1
SUB2API_RATE_MULTIPLIER=1
SUB2API_AUTO_PAUSE_ON_EXPIRED=true
SUB2API_MODEL_WHITELIST=
SUB2API_OPENAI_WS_MODE=off
SUB2API_OPENAI_PASSTHROUGH=false
SUB2API_OVERWRITE_ACCOUNT_SETTINGS=false

# API 鉴权（不设置则不启用，任何人都可访问）
API_KEY=

# Playwright 浏览器代理（可选）
# 示例：socks5://host.docker.internal:1080
# 注意：Playwright/Chromium 不支持带认证的 socks5（如 socks5://user:pass@host:port）
PLAYWRIGHT_PROXY_URL=
# 示例：localhost,127.0.0.1
PLAYWRIGHT_PROXY_BYPASS=

# 轮询配置
EMAIL_POLL_INTERVAL=3
EMAIL_POLL_TIMEOUT=300

# 自动巡检（API 模式下生效）
AUTO_CHECK_INTERVAL=300      # 巡检间隔（秒），默认 5 分钟
AUTO_CHECK_TARGET_SEATS=2    # swap_seat 保留的 ChatGPT seat / CPA OAuth active 数，允许 1~5
AUTO_CHECK_REPLACE_WITH_PENDING_INVITE=false # true 时 quota 全耗尽自动消费 pending invite 替换
SWAP_SEAT_WHITELIST_EMAILS=   # 白名单邮箱，逗号/分号/空白分隔；不查 quota、不切 seat、不启停 CPA OAuth
# 多 Team 配置。留空则只管理当前管理员登录态里的 Team。
# 示例：
# [
#   {"id":"team-a","account_id":"uuid-a","workspace_name":"Team A","max_chatgpt_active":2,"pending_invite_email":"pending-a@example.com"},
#   {"id":"team-b","account_id":"uuid-b","workspace_name":"Team B","max_chatgpt_active":1,"pending_invite_email":"pending-b@example.com"}
# ]
TEAM_WORKSPACES_JSON=
AUTO_CHECK_THRESHOLD=10      # 额度低于此百分比触发轮转，默认 10%
AUTO_CHECK_MIN_LOW=2         # 至少几个账号低于阈值才触发，默认 2
AUTO_CHECK_RETRY_ADD_PHONE=true          # 是否自动重试 add_phone（手机号验证）
AUTO_CHECK_ADD_PHONE_MAX_RETRIES=3       # add_phone 最大自动重试次数
